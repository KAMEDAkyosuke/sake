 static macdrv_metal_view my_macdrv_view_create_metal_view(macdrv_view v, macdrv_metal_device d)
 {
+    struct macdrv_client_surface *surface;
+    macdrv_metal_view hosted;
+    HWND hwnd;
+    RECT rect;
+
     TRACE("macdrv_view_create_metal_view %p %p\n", v, d);
-    return macdrv_view_create_metal_view(v, d);
+
+    if (!(surface = remote_lookup(remote_views, v))) return macdrv_view_create_metal_view(v, d);
+
+    /* The swapchain brings its own device and layer; the layer is exported through a
+     * CAContext and hosted by the process that owns the window, which is the only place
+     * it can be seen from. D3DMetal gets a view of its own for it, sized like the window. */
+    hwnd = surface->client.hwnd;
+    if (!macdrv_client_surface_acquire_metal_swapchain(surface))
+    {
+        ERR("no hosted swapchain for window %p of another process\n", hwnd);
+        return NULL;
+    }
+    if (!NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) memset(&rect, 0, sizeof(rect));
+    if (!(hosted = macdrv_create_hosted_metal_view(cgrect_from_rect(rect)))) return NULL;
+
+    remember_remote(&remote_handles, hosted, surface);
+    TRACE("window %p of another process: hosted swapchain %p, view %p\n", hwnd, surface->metal_swapchain, hosted);
+    return hosted;
 }
 
 static macdrv_metal_layer my_macdrv_view_get_metal_layer(macdrv_metal_view v)
 {
+    struct macdrv_client_surface *surface;
+
     TRACE("macdrv_view_get_metal_layer %p\n", v);
+
+    if ((surface = remote_lookup(remote_handles, v)))
+        return macdrv_swapchain_get_layer(surface->metal_swapchain);
     return macdrv_view_get_metal_layer(v);
 }
 
 static void my_macdrv_view_release_metal_view(macdrv_metal_view v)
 {
+    struct macdrv_client_surface *surface;
+
     TRACE("macdrv_view_release_metal_view %p\n", v);
+
+    if ((surface = remote_lookup(remote_handles, v)))
+    {
+        forget_remote(surface, v);
+        macdrv_view_release_metal_view(v);
+        client_surface_release(&surface->client);
+        return;
+    }
     return macdrv_view_release_metal_view(v);
 }
 
