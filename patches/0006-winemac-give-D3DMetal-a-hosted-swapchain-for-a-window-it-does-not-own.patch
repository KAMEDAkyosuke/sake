--- a/dlls/winemac.drv/d3dmetal.c
+++ b/dlls/winemac.drv/d3dmetal.c
@@ -92,6 +92,79 @@
 void OnMainThread(dispatch_block_t block);
 static void cf_client_surface_release(CFAllocatorRef allocator, const void *client_surface);
 
+/* Client surfaces made for windows another process owns: by the cocoa_view D3DMetal is
+ * handed in the window record, and by the view it is handed back as its "metal view".
+ *
+ * D3DMetal reads client_cocoa_view out of the record get_win_data() returns without
+ * checking the record for NULL; with a window of another process that read killed
+ * Steam's GPU process on every start (docs/runtime.md, 2026-09-20). A WineMetalView on
+ * that cocoa_view would never be shown either, since nothing in this process has the
+ * NSWindow. So the view is remembered here, view_create_metal_view() answers it with a
+ * swapchain hosted in the owner's window, and the two calls after that are answered from
+ * the same table. */
+static pthread_mutex_t remote_mutex = PTHREAD_MUTEX_INITIALIZER;
+static CFMutableDictionaryRef remote_views;    /* client cocoa_view -> struct macdrv_client_surface* */
+static CFMutableDictionaryRef remote_handles;  /* hosted metal view -> struct macdrv_client_surface* */
+
+static void remember_remote(CFMutableDictionaryRef *table, const void *key, struct macdrv_client_surface *surface)
+{
+    pthread_mutex_lock(&remote_mutex);
+    if (!*table) *table = CFDictionaryCreateMutable(NULL, 0, NULL, NULL);
+    CFDictionarySetValue(*table, key, surface);
+    pthread_mutex_unlock(&remote_mutex);
+}
+
+static struct macdrv_client_surface *remote_lookup(CFMutableDictionaryRef table, const void *key)
+{
+    struct macdrv_client_surface *surface = NULL;
+    pthread_mutex_lock(&remote_mutex);
+    if (table && key) surface = (struct macdrv_client_surface *)CFDictionaryGetValue(table, key);
+    pthread_mutex_unlock(&remote_mutex);
+    return surface;
+}
+
+static void forget_remote(struct macdrv_client_surface *surface, const void *handle)
+{
+    pthread_mutex_lock(&remote_mutex);
+    if (remote_handles) CFDictionaryRemoveValue(remote_handles, handle);
+    if (remote_views) CFDictionaryRemoveValue(remote_views, surface->cocoa_view);
+    pthread_mutex_unlock(&remote_mutex);
+}
+
+/* The record for a window that exists but belongs to another process. Only what
+ * D3DMetal reads on the way to view_create_metal_view() is real; the rest is what a
+ * child window of ours would have carried. A Chromium child has no non-client area, so
+ * the client rectangle is the window rectangle. */
+static struct d3dmetal_macdrv_win_data *remote_win_data(HWND hwnd, struct macdrv_client_surface *client_surface)
+{
+    struct d3dmetal_macdrv_win_data *d3dm_data;
+    HWND parent = NtUserGetAncestor(hwnd, GA_PARENT);
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    RECT rect;
+
+    if (!(d3dm_data = calloc(1, sizeof(*d3dm_data))))
+    {
+        client_surface_release(&client_surface->client);
+        return NULL;
+    }
+
+    NtUserGetWindowRect(hwnd, &rect, dpi);
+    if (parent && parent != NtUserGetDesktopWindow())
+        NtUserMapWindowPoints(0, parent, (POINT *)&rect, 2, dpi);
+
+    d3dm_data->hwnd = hwnd;
+    d3dm_data->client_cocoa_view = client_surface->cocoa_view;
+    d3dm_data->window_rect = rect;
+    d3dm_data->whole_rect = rect;
+    d3dm_data->client_rect = rect;
+    d3dm_data->on_screen = 1;
+
+    remember_remote(&remote_views, client_surface->cocoa_view, client_surface);
+    TRACE("window %p of another process: view %p rect %s\n", hwnd, client_surface->cocoa_view,
+          wine_dbgstr_rect(&rect));
+    return d3dm_data;
+}
+
